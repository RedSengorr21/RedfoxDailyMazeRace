name: Validate Redfox Daily Maze Race.html

on: [push, pull_request]

jobs:
  html-validation:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Check HTML5 Compliance
        uses: Cyb3r-Jak3/html5validator-action@v7.2.0
        with:
          root: ./ # The directory containing your HTML files
